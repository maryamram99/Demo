#: classes/admin/SettingsPage.php:138
#, fuzzy
#| msgid ""
#| "Select available currencies. Once selected go to the <strong>Exchange "
#| "rates</strong> menu and update the rates. The currencies without any rate "
#| "associated won't be available on the frontend. If <strong>no base "
#| "currency</strong> is set via the <strong>Exchange rates</strong> menu, "
